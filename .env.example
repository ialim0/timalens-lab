# Copy to .env and fill in. Never commit .env.

# Meta Model API key, from the Meta Model API dashboard (required for generation and the tutor)
MODEL_API_KEY=

# Tima's voice: Voxtral TTS (Mistral). Without it, the browser's own voice speaks.
MISTRAL_API_KEY=
# TTS_VOICE_FR=   (a Voxtral voice id; by default one is picked per language)
# TTS_VOICE_EN=

# Optional overrides
# META_BASE_URL=https://api.meta.ai/v1
# PLANNER_MODEL=muse-spark-1.3
# PLANNER_EFFORT=medium
# Which Meta model does which job (both default to PLANNER_MODEL):
# DESIGN_MODEL=muse-wonder-1.0              # Meta's most capable model designs the labs
# TUTOR_MODEL=muse-spark-1.3-contributor    # Contributor mode tutors at a lower price
# ASR_MODEL=muse-voice-transcribe-1.0

# Open weights: point the designer and the tutor at any OpenAI-compatible server (e.g. vLLM)
# PLANNER_BASE_URL=http://localhost:8000/v1
# PLANNER_API_KEY=

# Where generated labs and saved sessions are stored
# DATA_DIR=./data
